    "docker:build": "docker build -t minecraftstats/demo-server:latest .",
    "docker:run": "docker compose up -d"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
